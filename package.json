{
  "name": "tpr-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "The main workspace for the TPR project, containing both the frontend and backend applications.",
  "workspaces": [
    "packages/frontend",
    "packages/backend"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "install:all": "npm install --workspace=frontend && npm install --workspace=backend"
  },
  "devDependencies": {
    "eslint": "^8.0.0",
    "postcss": "^8.5.6",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.0.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@apollo/client": "^3.13.9",
    "@mantine/core": "^8.1.3",
    "@mantine/hooks": "^8.1.3",
    "@mantine/modals": "^8.1.3",
    "@types/mapbox-gl": "^3.4.1",
    "graphql": "^16.11.0",
    "mapbox-gl": "^3.13.0",
    "next": "^15.3.5",
    "react-icons": "^5.5.0",
    "react-map-gl": "^8.0.4",
    "react-select": "^5.10.2"
  }
}
