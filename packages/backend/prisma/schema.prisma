generator client {
  provider = "prisma-client-js"
  previewFeatures = ["extendedIndexes"] 
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
}

model Story {
  id         String     @id @default(cuid())
  title      String 
  steps      StoryStep[]
  dynamicStats   ImpactStat[]
}

model ImpactStat {
  id         Int     @id @default(autoincrement())
  title      String
  statistic  Int
  content    String?
  mediaType   String?
  mediaSrc    String?
  link       String?
  storyId    String
  story      Story @relation(fields: [storyId], references: [id])
}

model StoryStep {
  id          Int     @id @default(autoincrement())
  title       String
  content     String
  link        String?
  mediaType   String?
  mediaSrc    String?
  layersToShow  String[]
  layersToHide  String[]
  dynamicPoints DynamicPoint[]?
  nextButtonText  String?
  zoom           Float?
  latitude       Float?
  longitude      Float?
  pitch          Float?  // For a 3D perspective
  bearing        Float?  // For rotating the map

  storyId     String
  story       Story   @relation(fields: [storyId], references: [id])
}

model DynamicPoint {
  id          String @id @default(cuid())
  latitude    Float
  longitude   Float
  name        String
  description String
  color       String? // example: "#ff0000" for red
  markerImage String? // example: a URL to a custom icon
  mediaType   String?
  mediaSrc    String?
  storyStepId Int
  storyStep   StoryStep @relation(fields: [storyStepId], references: [id])
}