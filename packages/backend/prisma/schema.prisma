generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Story {
  id          String       @id @default(cuid())
  title       String
  impactStats ImpactStat[]
  steps       StoryStep[]
}

model ImpactStat {
  id         Int         @id @default(autoincrement())
  order      Int
  title      String
  statistic  Int
  content    String?
  link       String?
  storyId    String
  story      Story       @relation(fields: [storyId], references: [id])
  mediaItems MediaItem[]
}

model StoryStep {
  id              Int              @id @default(autoincrement())
  order           Int
  title           String
  content         String
  link            String?
  layersToShow    String[]
  layersToHide    String[]
  nextButtonText  String?
  zoom            Float?
  latitude        Float?
  longitude       Float?
  pitch           Float?
  bearing         Float?
  storyId         String
  modalPosition   ModalPosition?   @default(CENTER)
  dynamicPoints   DynamicPoint[]
  dynamicPolygons DynamicPolygon[]
  mediaItems      MediaItem[]
  story           Story            @relation(fields: [storyId], references: [id])
}

model DynamicPoint {
  latitude              Float
  longitude             Float
  name                  String
  description           String
  link                  String?
  color                 String?
  markerImage           String?
  storyStepId           Int
  id                    Int             @id @default(autoincrement())
  storyStep             StoryStep       @relation(fields: [storyStepId], references: [id])
  centerPointForPolygon DynamicPolygon? @relation("DynamicPointRelation")
  mediaItems            MediaItem[]
}

model DynamicPolygon {
  name          String
  fillColor     String
  fillOpacity   Float
  lineColor     String
  lineWidth     String
  storyStepId   Int
  geometry      Json
  id            Int           @id @default(autoincrement())
  centerPointId Int?          @unique
  centerPoint   DynamicPoint? @relation("DynamicPointRelation", fields: [centerPointId], references: [id])
  storyStep     StoryStep     @relation(fields: [storyStepId], references: [id])
  mediaItems    MediaItem[]
}

model MediaItem {
  id               Int             @id @default(autoincrement())
  order            Int
  type             MediaType
  source           String
  alt              String?
  caption          String?
  storyStepId      Int?
  impactStatId     Int?
  dynamicPointId   Int?
  dynamicPolygonId Int?
  dynamicPoint     DynamicPoint?   @relation(fields: [dynamicPointId], references: [id])
  dynamicPolygon   DynamicPolygon? @relation(fields: [dynamicPolygonId], references: [id])
  impactStat       ImpactStat?     @relation(fields: [impactStatId], references: [id])
  storyStep        StoryStep?      @relation(fields: [storyStepId], references: [id])
}

enum MediaType {
  IMAGE
  VIDEO
}

enum ModalPosition {
  CENTER
  TOP_LEFT
  TOP_RIGHT
  BOTTOM_LEFT
  BOTTOM_RIGHT
}
