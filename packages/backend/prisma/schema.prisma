generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MediaType {
  IMAGE
  VIDEO
}
enum ModalPosition {
  CENTER
  TOP_LEFT
  TOP_RIGHT
  BOTTOM_LEFT
  BOTTOM_RIGHT
}

model Story {
  id           String       @id @default(cuid())
  title        String
  steps        StoryStep[]
  impactStats ImpactStat[]
}

model ImpactStat {
  id         Int         @id @default(autoincrement())
  order      Int
  title      String
  statistic  Int
  content    String?
  mediaItems MediaItem[]
  link       String?
  storyId    String
  story      Story       @relation(fields: [storyId], references: [id])
}

model StoryStep {
  id              Int              @id @default(autoincrement())
  order           Int
  title           String
  content         String
  link            String?
  mediaItems      MediaItem[]
  layersToShow    String[]
  layersToHide    String[]
  dynamicPoints   DynamicPoint[]
  dynamicPolygons DynamicPolygon[]
  nextButtonText  String?
  modalPosition   ModalPosition? @default(CENTER)
  zoom            Float?
  latitude        Float?
  longitude       Float?
  pitch           Float? // For a 3D perspective
  bearing         Float? // For rotating the map

  storyId String
  story   Story  @relation(fields: [storyId], references: [id])
}

model DynamicPoint {
  id                    Int          @id @default(autoincrement())
  latitude              Float
  longitude             Float
  name                  String
  description           String
  centerPointForPolygon DynamicPolygon? @relation("DynamicPointRelation")
  color                 String? // example: "#ff0000" for red
  markerImage           String? // example: a URL to a custom icon
  mediaItems            MediaItem[]
  storyStepId           Int
  storyStep             StoryStep       @relation(fields: [storyStepId], references: [id])
}

model DynamicPolygon {
  id          Int       @id @default(autoincrement())
  name        String
  geometry    Json
  fillColor   String // example: '#0080ff' for blue
  fillOpacity Float // Anything between 0-1
  lineColor   String
  lineWidth   String
  mediaItems   MediaItem[]

  centerPointId Int?       @unique
  centerPoint   DynamicPoint? @relation("DynamicPointRelation", references: [id], fields: [centerPointId])

  storyStepId Int
  storyStep   StoryStep   @relation(fields: [storyStepId], references: [id])
}

model MediaItem {
  id      Int       @id @default(autoincrement())
  order   Int //Order of media display
  type    MediaType
  source  String //Media URL
  alt     String?
  caption String?

  storyStepId Int?
  storyStep   StoryStep? @relation(fields: [storyStepId], references: [id])

  dynamicPolygonId Int?
  dynamicPolygon   DynamicPolygon? @relation(fields: [dynamicPolygonId], references: [id])

  dynamicPointId Int?
  dynamicPoint   DynamicPoint? @relation(fields: [dynamicPointId], references: [id])

  impactStat   ImpactStat? @relation(fields: [impactStatId], references: [id])
  impactStatId Int?
}
