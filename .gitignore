
node_modules
# Keep environment variables out of version control
.env
.env.local
.env.*.local
# General
.DS_Store
*.log

# IDE and Environment files
.vscode/
.idea/
.env
.env.*
# ...but keep the template, which is safe to commit
!.env.example

# Dependencies for ALL packages
# The wildcard ** matches any subdirectory
**/node_modules
# Build output for ALL packages
**/dist
**/build
.next/

/generated/prisma

# GCP service account credentials — never commit
**/tipiraisers-*.json
**/*-service-account*.json
*.gcp.json

# Claude Code local worktrees / scratch — never part of the project
.claude/worktrees/

# npm workspaces: only the ROOT package-lock.json is authoritative.
# Per-package locks are ignored by npm and confuse Next.js workspace-root
# inference, so keep them from coming back.
packages/*/package-lock.json
