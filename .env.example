# Copy this file to .env.local (at the repo root) and fill in real values.
# .env.local is gitignored; .env.example is safe to commit.

# --- Backend ---
# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/TPRDB"

# --- Frontend ---
# GraphQL endpoint the Apollo client connects to.
# In dev this points at the local Apollo server (apollo.ts listens on 4000).
NEXT_PUBLIC_GRAPHQL_ENDPOINT="http://localhost:4000/"

# Mapbox public access token. Create one at https://account.mapbox.com/.
NEXT_PUBLIC_MAPBOX_TOKEN=""
